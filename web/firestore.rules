rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.email.matches('.*@admin\\.signglove\\.org') ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['text', 'category', 'status', 'timestamp']) &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 100 &&
             data.category is string &&
             data.status in ['private', 'approved', 'rejected'] &&
             data.timestamp is timestamp;
    }

    // Records collection (phrases captured from glove)
    match /records/{recordId} {
      
      // 1. Visitors can read approved records only
      // 2. Wearer can read their own private records
      // 3. Admin can read all records (including pending review)
      allow read: if resource.data.status == 'approved' ||
                     (isAuthenticated() && resource.data.authorUid == request.auth.uid) ||
                     isAdmin();

      // Mobile app (wearer) can create records with 'private' status only
      allow create: if isAuthenticated() &&
                       isValidRecord(request.resource.data) &&
                       request.resource.data.status == 'private' &&
                       request.resource.data.authorUid == request.auth.uid;

      // Only authenticated admin can approve, reject or edit status
      allow update: if isAdmin() && 
                       isValidRecord(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']);

      // Only admin can delete records
      allow delete: if isAdmin();
    }

    // Admins registry (read-only except by backend admin sdk)
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}

